# ==============================================================
# PANTRYPAL BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================

# Server Network Settings
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://localhost:27017/pantrypal
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pantrypal?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pantrypal

# JWT Authentication
JWT_SECRET=pantrypal_super_secret_jwt_key_2026_dev_mode
JWT_EXPIRE=30d

# Base API URL
API_BASE_URL=http://localhost:5000

# Razorpay Payment Gateway (Test or Live API Keys)
# Generate via: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_pantrypal123
RAZORPAY_KEY_SECRET=secret_test_pantrypal456
RAZORPAY_WEBHOOK_SECRET=webhook_secret_789

# Google Maps Platform (Geocoding & Distance Matrix API)
# Generate via: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=AIzaSyPantryPalDemoKeyForMaps123

# Firebase Admin SDK & Cloud Messaging (Push Notifications)
# Download Service Account JSON via Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=pantrypal-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-pantrypal@pantrypal-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...=\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVER_KEY=AAAA1234567890abcdef
