# ==============================================================
# PANTRYPAL REACT NATIVE (ANDROID / IOS) CONFIGURATION
# ==============================================================

# API Base URL Endpoint
# - For Android Emulator (default): http://10.0.2.2:5000/api
# - For Android via reverse port proxy: http://localhost:5000/api (run `adb reverse tcp:5000 tcp:5000`)
# - For Physical Device on Local Wi-Fi: http://192.168.x.x:5000/api
# - For Production Deployment: https://api.yourdomain.com/api
REACT_APP_API_BASE_URL=http://10.0.2.2:5000/api

# Razorpay Client Key ID (for mobile checkout SDK)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_pantrypal123

# Google Maps API Key
# In Android, also configure in android/app/src/main/AndroidManifest.xml:
# <meta-data android:name="com.google.android.geo.API_KEY" android:value="YOUR_GOOGLE_MAPS_KEY"/>
REACT_APP_GOOGLE_MAPS_API_KEY=AIzaSyPantryPalDemoKeyForMaps123

# Firebase Services (FCM Push Notifications & Auth)
# Place your 'google-services.json' in mobile-app/android/app/
