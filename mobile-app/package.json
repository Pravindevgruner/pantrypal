{
  "name": "pantrypal-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "unset JAVA_TOOL_OPTIONS && export JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@17} && react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:debug": "unset JAVA_TOOL_OPTIONS && export JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@17} && cd android && ./gradlew assembleDebug",
    "build:release": "unset JAVA_TOOL_OPTIONS && export JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@17} && cd android && ./gradlew assembleRelease",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.6.8",
    "dayjs": "^1.11.10",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-safe-area-context": "^4.9.0",
    "react-native-screens": "3.29.0",
    "react-native-vector-icons": "^10.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "^0.73.21",
    "@react-native/metro-config": "^0.73.5",
    "metro-react-native-babel-preset": "^0.77.0"
  },
  "engines": {
    "node": ">=18"
  }
}
